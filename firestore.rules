rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User profiles: each user can only read and write their own private profile (PII protection)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == userId;
      allow delete: if isAdmin();
    }

    // Farms collection: owned by user
    match /farms/{farmId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Fields, crops, scans, activities, alerts, sensors: user-isolated
    match /fields/{fieldId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /crops/{cropId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /plantScans/{scanId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /farmActivities/{activityId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /alerts/{alertId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /sensorReadings/{sensorId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only configured via Cloud Console or trusted backend
    }

    // Public agricultural reference knowledge
    match /knowledgeSources/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /diseaseCases/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pestCases/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
